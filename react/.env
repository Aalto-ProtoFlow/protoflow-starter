# Your team server. Replace YOUR-TEAM with its name, for example alpha.
# These addresses are public, not secrets, so this file is committed: hosting
# services such as Vercel and Netlify then build the app without extra settings.
VITE_API_URL=https://YOUR-TEAM.proto.aalto.fi/api
VITE_WS_URL=wss://YOUR-TEAM.proto.aalto.fi/ws/app
